<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Checkstyle для Gatling Java (Cases / Scenarios / Simulations / Feeders).

  Ориентиры — эталонный код проекта (LicensesCase, LicensesScenario, OTT_all_debug):
  - 4 пробела, без табов
  - фигурные скобки класса на той же строке: public class Foo {
  - цепочки Gatling DSL с отступом +4 на уровень (.post, .body, .check)
  - import: сначала обычные (cases → config → feeders → io.gatling → java), затем static
  - star-import допустим для CoreDsl.* / HttpDsl (типично для Gatling)
  - константы JSONS_PATH, SCN — UPPER_SNAKE_CASE
  - поля UC — UC{NN}_{METHOD}_{Name}
  - поля сценариев scn, scn_ott_debug — lower_snake_case

  Намеренно НЕ проверяется (пока не завершена автоматизация профиля):
  - ProfileConfig.getWeight vs хардкод WithWeight
  - injectOpen vs getInjectUsers
  - extends Methods, наличие .check(status()) — это review_gates.py / gatling-reviewer

  Suppressions: checkstyle/suppressions.xml
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>

    <!-- Без BOM, один перевод строки в конце файла -->
    <module name="NewlineAtEndOfFile"/>
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!-- Длина строки: в Simulation/Scenario длинные WithWeight/injectOpen допустимы до 150 -->
    <module name="LineLength">
        <property name="max" value="150"/>
        <property name="ignorePattern" value="^import\s|^package\s|^\s*//|^\s*\*|http\(|\.check\("/>
    </module>

    <module name="TreeWalker">
        <property name="tabWidth" value="4"/>

        <!-- Отступы: 4 пробела (как LicensesCase / LicensesScenario) -->
        <module name="Indentation">
            <property name="basicOffset" value="4"/>
            <property name="braceAdjustment" value="0"/>
            <property name="caseIndent" value="4"/>
            <property name="throwsIndent" value="4"/>
            <property name="lineWrappingIndentation" value="8"/>
            <property name="arrayInitIndent" value="4"/>
            <property name="forceStrictCondition" value="false"/>
        </module>

        <!-- Скобки: public class Foo {  и  setUp( ... ) { -->
        <module name="LeftCurly">
            <property name="option" value="eol"/>
        </module>
        <module name="RightCurly">
            <property name="option" value="same"/>
        </module>
        <module name="NeedBraces"/>

        <!-- Пробелы: if (x), метод( arg ), запятая после , -->
        <module name="WhitespaceAround">
            <property name="allowEmptyConstructors" value="true"/>
            <property name="allowEmptyMethods" value="true"/>
            <property name="allowEmptyTypes" value="true"/>
            <property name="allowEmptyLoops" value="true"/>
        </module>
        <module name="WhitespaceAfter"/>
        <module name="NoWhitespaceBefore"/>
        <module name="SingleSpaceSeparator"/>
        <module name="GenericWhitespace"/>
        <module name="ParenPad"/>

        <!-- Пустые строки: не более 2 подряд -->
        <module name="EmptyLineSeparator">
            <property name="allowNoEmptyLineBetweenFields" value="true"/>
            <property name="allowMultipleEmptyLines" value="false"/>
            <property name="tokens" value="PACKAGE_DEF, IMPORT, STATIC_IMPORT, CLASS_DEF, INTERFACE_DEF, ENUM_DEF, STATIC_INIT, INSTANCE_INIT, METHOD_DEF"/>
        </module>

        <!-- Импорты: порядок как в LicensesCase / LicensesScenario -->
        <module name="ImportOrder">
            <property name="groups" value="/^cases\./,/^config\./,/^feeders\./,/^scenarios\./,/^io\.gatling\./,/^java\./,/^javax\./,/^org\./,STATIC"/>
            <property name="ordered" value="true"/>
            <property name="separated" value="true"/>
            <property name="option" value="bottom"/>
            <property name="sortStaticImportsAlphabetically" value="true"/>
        </module>
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <!-- Star-import для Gatling DSL — норма; см. suppressions.xml -->

        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>

        <!-- Именование (Java + соглашения проекта) -->
        <module name="PackageName">
            <!-- cases.ZK, scenarios.ZK — доменные сегменты с заглавными буквами -->
            <property name="format" value="^[a-z]+(\.[a-zA-Z][a-zA-Z0-9_]*)*$"/>
        </module>
        <module name="TypeName"/>
        <module name="ConstantName">
            <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
        </module>
        <module name="StaticVariableName">
            <!-- scn_ott_debug, UC01_POST_*, Debug, defaultFeeder, rqUidsFeeder -->
            <property name="format" value="^[a-z][a-z0-9_]*$|^[a-z][a-zA-Z0-9]*$|^[A-Z][a-z][a-zA-Z0-9]*$|^[A-Z][A-Z0-9_]*(_[a-zA-Z0-9_]+)*$"/>
        </module>
        <module name="MemberName">
            <property name="format" value="^[a-z][a-z0-9_]*$"/>
        </module>
        <module name="MethodName"/>
        <module name="ParameterName"/>
        <module name="LocalVariableName"/>

        <!-- Стиль литералов -->
        <module name="StringLiteralEquality"/>
        <module name="EqualsHashCode"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="NoFinalizer"/>

        <!-- Комментарии: // с пробелом (не //группы) -->
        <module name="TodoComment">
            <property name="format" value="(TODO|FIXME|DEBUG ONLY)"/>
        </module>

        <module name="SuppressionCommentFilter">
            <property name="offCommentFormat" value="CHECKSTYLE\:OFF\s\(\w+\)"/>
            <property name="onCommentFormat" value="CHECKSTYLE\:ON"/>
        </module>
    </module>

    <module name="RegexpSingleline">
        <property name="format" value="^\s*//[^\s/].*$"/>
        <property name="message" value="После // нужен пробел: // комментарий (как в LicensesScenario)"/>
        <property name="ignoreCase" value="true"/>
    </module>

    <module name="SuppressionFilter">
        <property name="file" value="${config_loc}/suppressions.xml"/>
        <property name="optional" value="false"/>
    </module>
</module>
