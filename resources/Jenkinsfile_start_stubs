                    //sh "JENKINS_NODE_COOKIE=dontKillMe"

                    sshScript = '''
                        #!/bin/bash
                        
                        # Проверка, занят ли порт 8080
                        if ! lsof -i:8080 > /dev/null; then
                            echo "Порт 8080 свободен."
                            
                            # Проверка существования скриптов и их запуск
                            if [ -f "./mockery.sh" ]; then
                                echo "Запускаем mockery.sh..."
                                nohup ./mockery.sh > /dev/null 2>&1 &
                            elif [ -f "./mockery608.sh" ]; then
                                echo "Запускаем mockery608.sh..."
                                nohup ./mockery608.sh > /dev/null 2>&1 &
                            else
                                echo "Ни один из скриптов mockery.sh или mockery608.sh не найден."
                            fi
                        else
                            echo "Порт 8080 занят."
                        fi
                        if [ -f "./mockery608.sh" ]; then
                            if ! lsof -i:6666 > /dev/null; then
                                nohup java -Dserver.port=6666 -jar /home/pprb_test/finmonstub/SrpStub/srpstub/SRPStub.jar > /dev/null 2>&1 &
                            fi
                        fi
						'''
                    withCredentials([usernamePassword(
                            credentialsId: "pprb_test",
                            usernameVariable: 'remoteHost',
                            passwordVariable: 'remotePassword',
                    )]) {
                        shCommand = "sshpass -p '${remotePassword}' ssh -o StrictHostKeyChecking=no ${remoteHost} '${sshScript}'"
                        sh shCommand
                    }
                }
