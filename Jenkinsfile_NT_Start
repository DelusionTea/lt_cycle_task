// Старт-джоба ночного цикла НТ (адаптация resources/Jenkinsfile).
// Отличия от исходной:
//  - cron-триггер для ночного запуска;
//  - неинтерактивный режим (без input()) при запуске по таймеру / с заданным packageSimulation;
//  - параметр TARGET_PERCENT и генерация profile.properties из profile.yaml перед mvn,
//    который читает Java-класс ProfileConfig (веса randomSwitch + интенсивность injectOpen);
//  - сохранён механизм wrapper/status/lockfile/tarball.
//
// Анализ результата вынесен в отдельную джобу (Jenkinsfile_NT_Analyze_Report),
// которая переподцепляется к завершённому прогону по gatling_status.txt и gatling_report.tar.gz.

pipeline {
    agent {
        node { label 'sberlinux&&Linux_Default' }
    }
    triggers {
        // Ночной запуск (~22:00). H — для разнесения нагрузки на мастере.
        cron('H 22 * * *')
    }
    environment {
        // Каталог скриптов Gatling в репозитории (структура: pom.xml, ltAuto/, profiles/, src/).
        GATLING_DIR       = "gatling/gatlingScripts"
        MAVEN_HOME        = "/home/pprb_test/apache-maven-3.9.6/"
        REMOTE_RUNLOG     = "/home/pprb_test/gatling_run.log"
        REMOTE_PIDFILE    = "/home/pprb_test/gatling_maven.pid"
        REMOTE_WPIDFILE   = "/home/pprb_test/gatling_wrapper.pid"
        REMOTE_STATUSFILE = "/home/pprb_test/gatling_status.txt"
        REMOTE_LOCKFILE   = "/home/pprb_test/lockfileGatling.txt"
        REMOTE_WRAPPER    = "/home/pprb_test/gatling_wrapper.sh"
        REMOTE_PROFILE    = "/home/pprb_test/gatling_job/gatlingScripts/profile.properties"
    }
    parameters {
        string(name: 'START_TIME', defaultValue: 'now', description: 'now или HH:mm. Тест идёт через nohup.')
        string(name: 'packageSimulation', defaultValue: 'pprbSberrating.All.OTT_all_debug',
               description: 'Класс симуляции (обязателен для unattended/cron запуска).')
        string(name: 'TARGET_PERCENT', defaultValue: '100', description: 'Целевой % от профиля (масштаб интенсивности).')
        choice(name: 'ACTION', choices: ['ЗАПУСТИТЬ ТЕСТ', 'ТОЛЬКО ОБНОВИТЬ СКРИПТЫ'],
               description: 'ЗАПУСТИТЬ ТЕСТ — синк + запуск; ТОЛЬКО ОБНОВИТЬ СКРИПТЫ — только rsync без mvn.')
        string(name: 'APPLICATION', defaultValue: 'efsFinmonWeb',
               description: 'Имя АС = каталог profiles/<APPLICATION>/ и cases/<APPLICATION>/')
        string(name: 'PROFILE_YAML', defaultValue: '',
               description: 'Путь к profile.yaml относительно GATLING_DIR. Пусто → profiles/<APPLICATION>/profile.yaml')
        booleanParam(name: 'USE_SDD_SPEC', defaultValue: false, description: 'Использовать SDD/spec.yaml как источник профиля')
        booleanParam(name: 'USE_OPENSPEC', defaultValue: false, description: 'Сконвертировать OpenSpec/GigaCLI артефакт в SDD/spec.yaml перед валидацией')
        string(name: 'OPENSPEC_PATH', defaultValue: '', description: 'Путь к OpenSpec артефакту yaml/json (относительно корня репозитория)')
        string(name: 'SPEC_PATH', defaultValue: '', description: 'Путь к spec.yaml (относительно корня репозитория)')
        booleanParam(name: 'UNATTENDED', defaultValue: false, description: 'Принудительно неинтерактивный режим (без input()).')
        credentials(name: 'CREDS', defaultValue: '', description: 'Ключи от генератора', credentialType: 'Username with password', required: true)
    }
    options {
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }
    stages {
        stage('Init') {
            steps {
                script {
                    // Запуск по таймеру (cron) => unattended
                    def timerCause = currentBuild.getBuildCauses('hudson.triggers.TimerTrigger$TimerTriggerCause')
                    env.IS_UNATTENDED = (params.UNATTENDED || (timerCause != null && !timerCause.isEmpty())) ? 'true' : 'false'
                    echo "UNATTENDED=${env.IS_UNATTENDED}"
                    if (!(params.TARGET_PERCENT ==~ /^\\d+(\\.\\d+)?$/)) {
                        error "TARGET_PERCENT должен быть числом, получено: '${params.TARGET_PERCENT}'"
                    }

                    if (env.IS_UNATTENDED == 'true' && (params.packageSimulation == null || params.packageSimulation.trim() == '')) {
                        error "Unattended-запуск требует непустой packageSimulation."
                    }
                    env.FINAL_TARGET = params.packageSimulation.trim()
                    env.USE_SDD_SPEC_EFFECTIVE = (params.USE_SDD_SPEC || params.USE_OPENSPEC) ? 'true' : 'false'
                    if (env.USE_SDD_SPEC_EFFECTIVE == 'true') {
                        if (params.SPEC_PATH == null || params.SPEC_PATH.trim() == '') {
                            error "USE_SDD_SPEC/USE_OPENSPEC требует непустой SPEC_PATH."
                        }
                        env.SPEC_PATH = params.SPEC_PATH.trim()
                        if (params.USE_OPENSPEC) {
                            if (params.OPENSPEC_PATH == null || params.OPENSPEC_PATH.trim() == '') {
                                error "USE_OPENSPEC=true требует непустой OPENSPEC_PATH."
                            }
                            env.OPENSPEC_PATH = params.OPENSPEC_PATH.trim()
                        }
                        env.PROFILE_YAML = "(from spec)"
                    } else {
                        env.PROFILE_YAML = params.PROFILE_YAML?.trim() ?
                            params.PROFILE_YAML.trim() : "profiles/${params.APPLICATION}/profile.yaml"
                    }
                    echo "PROFILE_YAML=${env.PROFILE_YAML}"
                }
            }
        }
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Validate repository files') {
            steps {
                script {
                    if (!fileExists("${GATLING_DIR}")) {
                        error("Не найден каталог '${GATLING_DIR}'. Поместите Gatling-скрипты в '${GATLING_DIR}' (ожидаются pom.xml, ltAuto, src, profiles).")
                    }
                    if (!fileExists("${GATLING_DIR}/ltAuto/profile_to_props.py")) {
                        error("Не найден файл '${GATLING_DIR}/ltAuto/profile_to_props.py'. Он нужен для генерации profile.properties из profile.yaml. Добавьте файл по этому пути.")
                    }
                    if (env.USE_SDD_SPEC_EFFECTIVE == 'true') {
                        if (!fileExists("SDD/ltAuto/openspec_preflight.py")) {
                            error("Не найден файл 'SDD/ltAuto/openspec_preflight.py'. Он нужен для preflight (convert/validate/dry-run). Добавьте файл по этому пути.")
                        }
                        if (!fileExists("SDD/ltAuto/spec_to_props.py")) {
                            error("Не найден файл 'SDD/ltAuto/spec_to_props.py'. Он нужен для генерации profile.properties из spec.yaml. Добавьте файл по этому пути.")
                        }
                        if (!fileExists(env.SPEC_PATH)) {
                            error("Не найден spec-файл '${env.SPEC_PATH}'. Укажите корректный SPEC_PATH и добавьте файл в репозиторий по этому пути.")
                        }
                        if (params.USE_OPENSPEC && !fileExists(env.OPENSPEC_PATH)) {
                            error("Не найден OpenSpec-файл '${env.OPENSPEC_PATH}'. Укажите корректный OPENSPEC_PATH и добавьте артефакт в репозиторий по этому пути.")
                        }
                    } else {
                        def profilePath = "${GATLING_DIR}/${env.PROFILE_YAML}"
                        if (!fileExists(profilePath)) {
                            error("Не найден профиль '${profilePath}'. Для non-SDD режима добавьте profile.yaml по этому пути или передайте корректный PROFILE_YAML.")
                        }
                    }
                }
            }
        }
        stage('Preflight SDD/OpenSpec') {
            when {
                expression {
                    return params.ACTION == 'ЗАПУСТИТЬ ТЕСТ' && env.USE_SDD_SPEC_EFFECTIVE == 'true'
                }
            }
            steps {
                sh """
                    if [ "${params.USE_OPENSPEC}" = "true" ]; then
                      python3 SDD/ltAuto/openspec_preflight.py \
                        --spec '${env.SPEC_PATH}' \
                        --expected_service '${params.APPLICATION}' \
                        --use_openspec \
                        --openspec '${env.OPENSPEC_PATH}' \
                        --target_percent '${params.TARGET_PERCENT}' \
                        --dry_profile_props
                    else
                      python3 SDD/ltAuto/openspec_preflight.py \
                        --spec '${env.SPEC_PATH}' \
                        --expected_service '${params.APPLICATION}' \
                        --target_percent '${params.TARGET_PERCENT}' \
                        --dry_profile_props
                    fi
                """
            }
        }
        stage('Generate profile.properties') {
            when { expression { params.ACTION == 'ЗАПУСТИТЬ ТЕСТ' } }
            steps {
                script {
                    // Генерируем профиль из YAML под целевой %.
                    // Скрипты и профили лежат в ${GATLING_DIR}; веса randomSwitch
                    // и request_classes (src/test/java/cases/...) резолвятся относительно него.
                    sh """
                        if [ "${env.USE_SDD_SPEC_EFFECTIVE}" = "true" ]; then
                          python3 SDD/ltAuto/spec_to_props.py \
                            --spec '${env.SPEC_PATH}' \
                            --target_percent '${params.TARGET_PERCENT}' \
                            --output profile.properties
                        else
                          python3 ${GATLING_DIR}/ltAuto/profile_to_props.py \
                            --profile '${GATLING_DIR}/${env.PROFILE_YAML}' \
                            --target_percent '${params.TARGET_PERCENT}' \
                            --output profile.properties
                        fi
                        cat profile.properties
                    """
                }
            }
        }
        stage('Prepare & Sync') {
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: params.CREDS,
                            usernameVariable: 'remoteHost', passwordVariable: 'remotePassword')]) {

                        // Проверка занятости генератора
                        def lockCheck = '''#!/bin/bash
                            [ -f "/home/pprb_test/lockfileGatling.txt" ] && cat /home/pprb_test/lockfileGatling.txt 2>/dev/null || echo 0
                        '''
                        def lockValue = sh(script: "sshpass -p '${remotePassword}' ssh -o StrictHostKeyChecking=no ${remoteHost} '${lockCheck}'", returnStdout: true).trim()

                        if (lockValue != '0') {
                            if (env.IS_UNATTENDED == 'true') {
                                echo "Генератор занят (lock=${lockValue}). Unattended: ждём освобождения."
                                timeout(time: 12, unit: 'HOURS') {
                                    waitUntil {
                                        def lv = sh(script: "sshpass -p '${remotePassword}' ssh -o StrictHostKeyChecking=no ${remoteHost} '${lockCheck}'", returnStdout: true).trim()
                                        if (lv == '0') { return true }
                                        sleep 60; return false
                                    }
                                }
                            } else {
                                def choice = input(message: "Генератор занят (lock=${lockValue}).",
                                        parameters: [choice(name: 'A', choices: ['Подождать', 'Отменить'])])
                                if (choice == 'Отменить') { error 'Отменено пользователем: генератор занят.' }
                                timeout(time: 12, unit: 'HOURS') {
                                    waitUntil {
                                        def lv = sh(script: "sshpass -p '${remotePassword}' ssh -o StrictHostKeyChecking=no ${remoteHost} '${lockCheck}'", returnStdout: true).trim()
                                        if (lv == '0') { return true }
                                        sleep 30; return false
                                    }
                                }
                            }
                        }

                        // Синхронизация скриптов. Внешние jar (Kafka/Akka/PostgreSQL) в этом
                        // репозитории лежат внутри gatlingScripts/src/test/resources/lib и едут
                        // вместе с основным rsync. Отдельный gatling/libs — легаси; синкаем его
                        // только если он есть в чекауте и на удалёнке пусто.
                        sh "sshpass -p '${remotePassword}' ssh -o StrictHostKeyChecking=no ${remoteHost} 'mkdir -p gatling_job/gatlingScripts gatling_job/libs'"
                        def hasLegacyLibs = sh(script: "[ -d '${GATLING_DIR}/../libs' ] && echo true || echo false", returnStdout: true).trim()
                        if (hasLegacyLibs == 'true') {
                            def libsExist = sh(script: "sshpass -p '${remotePassword}' ssh -o StrictHostKeyChecking=no ${remoteHost} '[ -d gatling_job/libs ] && ls -A gatling_job/libs >/dev/null 2>&1 && echo true || echo false'", returnStdout: true).trim()
                            if (libsExist == 'false') {
                                sh "sshpass -p '${remotePassword}' rsync -avz --delete -e 'ssh -o StrictHostKeyChecking=no' ${GATLING_DIR}/../libs/ ${remoteHost}:gatling_job/libs/"
                            }
                        }
                        sh "sshpass -p '${remotePassword}' rsync -avz --delete -e 'ssh -o StrictHostKeyChecking=no' ${GATLING_DIR}/ ${remoteHost}:gatling_job/gatlingScripts/"

                        // Кладём profile.properties рядом со скриптами (только при запуске теста)
                        if (params.ACTION == 'ЗАПУСТИТЬ ТЕСТ') {
                            sh "sshpass -p '${remotePassword}' scp -o StrictHostKeyChecking=no profile.properties ${remoteHost}:${REMOTE_PROFILE}"
                        }

                        env.REMOTE_HOST = remoteHost
                        currentBuild.displayName = "${remoteHost} | ${env.FINAL_TARGET} | ${params.TARGET_PERCENT}%"
                    }
                }
            }
        }
        stage('Run test (nohup)') {
            when { expression { params.ACTION == 'ЗАПУСТИТЬ ТЕСТ' } }
            steps {
                script {
                    withCredentials([usernamePassword(credentialsId: params.CREDS,
                            usernameVariable: 'remoteHost', passwordVariable: 'remotePassword')]) {

                        def wrapperContent = """#!/bin/bash
exec > ${REMOTE_RUNLOG} 2>&1
echo "--- Wrapper Start: \$(date) ---"
echo \$\$ > ${REMOTE_WPIDFILE}
if [ "${params.START_TIME}" != "now" ]; then
    echo "Waiting for scheduled start at ${params.START_TIME}..."
    while [ "\$(date +%H:%M)" != "${params.START_TIME}" ]; do sleep 15; done
fi
echo "STARTED \$(date) simulation=simulations.${env.FINAL_TARGET}" > ${REMOTE_STATUSFILE}
echo 1 > ${REMOTE_LOCKFILE}
cd /home/pprb_test/gatling_job/gatlingScripts || exit 1
source ~/.bash_profile 2>/dev/null || true
source ~/.bashrc 2>/dev/null || true
export MAVEN_OPTS="-Dmaven.settings.file=/home/pprb_test/.m2/settings.xml"
export LOG_LEVEL=ERROR
CLASS="${env.FINAL_TARGET}"
[[ \$CLASS != simulations.* ]] && CLASS="simulations.\$CLASS"
echo "Launching Maven via nohup for class: \$CLASS (target=${params.TARGET_PERCENT}%)"
nohup /home/pprb_test/apache-maven-3.9.6/bin/mvn gatling:test -B -q \\
    -s /home/pprb_test/.m2/settings.xml \\
    -D"gatling.simulationClass=\$CLASS" \\
    -DprofileProperties=${REMOTE_PROFILE} \\
    -Dgatling.resultsFolder=results \\
    -Dmaven.repo.local=/home/pprb_test/.m2 \\
    -D"logback.level.root=ERROR" \\
    -D"jenkins.build.tag=${env.BUILD_TAG}" \\
    -Dgatling.core.directory.results=/home/pprb_test/gatling_job/gatlingScripts/results \\
    > /dev/null 2> /home/pprb_test/nohup.out &
MAVEN_PID=\$!
echo \$MAVEN_PID > ${REMOTE_PIDFILE}
echo "Maven PID: \$MAVEN_PID"
wait \$MAVEN_PID
MAVEN_EXIT=\$?
echo 0 > ${REMOTE_LOCKFILE}
rm -f ${REMOTE_PIDFILE} ${REMOTE_WPIDFILE}
rm -f /home/pprb_test/gatling_report.tar.gz
if cd results 2>/dev/null; then
    LATEST=\$(ls -td -- */ 2>/dev/null | head -n 1)
    [ -n "\$LATEST" ] && tar -czf /home/pprb_test/gatling_report.tar.gz "\$LATEST"
fi
if [ \$MAVEN_EXIT -eq 0 ]; then
    echo "SUCCESS \$(date)" > ${REMOTE_STATUSFILE}
else
    echo "FAILED exit_code=\$MAVEN_EXIT \$(date)" > ${REMOTE_STATUSFILE}
fi
"""
                        writeFile file: 'gatling_wrapper.sh', text: wrapperContent
                        sh "sshpass -p '${remotePassword}' scp -o StrictHostKeyChecking=no gatling_wrapper.sh ${remoteHost}:${REMOTE_WRAPPER}"
                        sh "sshpass -p '${remotePassword}' ssh -o StrictHostKeyChecking=no ${remoteHost} 'tr -d \"\\r\" < ${REMOTE_WRAPPER} > ${REMOTE_WRAPPER}.tmp && mv ${REMOTE_WRAPPER}.tmp ${REMOTE_WRAPPER} && chmod +x ${REMOTE_WRAPPER}'"
                        sh "sshpass -p '${remotePassword}' ssh -o StrictHostKeyChecking=no ${remoteHost} 'nohup ${REMOTE_WRAPPER} > /home/pprb_test/nohup_wrapper.log 2>&1 &'"
                        echo "Тест запущен в фоне (nohup). Анализ выполнит Jenkinsfile_NT_Analyze_Report."
                    }
                }
            }
        }
    }
    post {
        aborted {
            script {
                if (env.REMOTE_HOST?.trim() && env.FINAL_TARGET?.trim()) {
                    try {
                        withCredentials([usernamePassword(credentialsId: params.CREDS,
                                usernameVariable: 'remoteHost', passwordVariable: 'remotePassword')]) {
                            withEnv(["RH=${remoteHost}", "RP=${remotePassword}", "FT=${env.FINAL_TARGET}",
                                     "RWPID=${env.REMOTE_WPIDFILE}", "RPID=${env.REMOTE_PIDFILE}", "RLOCK=${env.REMOTE_LOCKFILE}"]) {
                                sh '''
                                    sshpass -p "$RP" ssh -o StrictHostKeyChecking=no "$RH" '
                                        set +e
                                        killtree() { _p="$1"; [ -z "$_p" ] && return 0; for c in $(pgrep -P "$_p" 2>/dev/null); do killtree "$c"; done; kill -15 "$_p" 2>/dev/null||true; sleep 1; kill -9 "$_p" 2>/dev/null||true; }
                                        PIDS="$(pgrep -f "gatling.simulationClass=simulations.$FT" 2>/dev/null || pgrep -f "gatling.simulationClass=$FT" 2>/dev/null || true)"
                                        for p in $PIDS; do killtree "$p"; done
                                        [ -f "$RWPID" ] && killtree "$(cat "$RWPID" 2>/dev/null)"
                                        [ -f "$RPID" ]  && killtree "$(cat "$RPID" 2>/dev/null)"
                                        rm -f "$RPID" "$RWPID"; echo 0 > "$RLOCK"
                                    '
                                '''
                            }
                        }
                    } catch (Exception e) {
                        echo "POST(aborted) cleanup error: ${e.getMessage()}"
                    }
                }
            }
        }
    }
}
